%% Hardware — physical cause-and-effect chain (below ROS layer)

flowchart TB
    classDef hw fill:#fce4ec,stroke:#c62828
    classDef sensor fill:#e3f2fd,stroke:#1565c0
    classDef ctrl fill:#e8f5e9,stroke:#2e7d32

    FISH["Real fish / manual load<br/>on fishing line"]:::hw
    LINE["Physical line"]:::hw
    ROD["Rod tip + load cell mount"]:::hw
    HX["HX711 ADC<br/>calibration_offset · calibration_scale"]:::sensor
    LC["load_cell_node<br/>moving average · noise floor"]:::sensor
    CTRL["tension controller"]:::ctrl
    PTC["position_trajectory_controller"]:::ctrl
    DX["Dynamixel servos<br/>Joint_1 · Joint_2"]:::hw

    FISH --> LINE
    LINE --> ROD
    ROD --> HX
    HX -->|"read_raw_adc()"| LC
    LC -->|"FishingTension"| CTRL
    CTRL -->|"JointTrajectory"| PTC
    PTC --> DX
    DX -->|"changes rod angle →<br/>line tension"| LINE
