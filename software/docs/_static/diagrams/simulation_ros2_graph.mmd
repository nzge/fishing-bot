%% Fishing Robot — MuJoCo Simulation ROS 2 Graph
%% Standalone diagram for reports. Also embedded in docs/ros2/simulation.md
%% Render: https://mermaid.live  |  mmdc -i simulation_ros2_graph.mmd -o simulation_ros2_graph.svg

flowchart TB
    classDef node fill:#e8f4fc,stroke:#0b6e99,stroke-width:2px
    classDef simOnly fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef ctrl fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef infra fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px

    subgraph launch["bringup — robot.launch.py (use_sim:=true)"]
        direction TB
    end

    subgraph tf["Transform & Description"]
        RSP["robot_state_publisher<br/><i>robot_state_publisher</i>"]:::infra
    end

    subgraph physics["MuJoCo + ros2_control"]
        MJ["mujoco_ros2_control<br/>ros2_control_node<br/><i>hosts /controller_manager</i>"]:::simOnly
        JSB["joint_state_broadcaster"]:::infra
        PTC["position_trajectory_controller<br/><i>JointTrajectoryController</i>"]:::ctrl
        FEC["fish_effort_controller<br/><i>ForwardCommandController</i>"]:::simOnly
        TSB["tension_sensor_broadcaster<br/><i>ForceTorqueSensorBroadcaster</i>"]:::simOnly
    end

    subgraph apps["Application nodes (ament_python)"]
        CTRL["admittance_controller<br/>OR force_feedback_controller<br/><i>control</i>"]:::ctrl
        LC["load_cell_node<br/><i>sensors — source:=sim_fts</i>"]:::node
        FISH["fish_agent<br/><i>planning</i>"]:::simOnly
        REC["recorder<br/><i>diagnostics — record:=true</i>"]:::node
    end

    subgraph topics["Topics (message types)"]
        T_JS["/joint_states<br/>sensor_msgs/JointState"]
        T_TRAJ["/position_trajectory_controller/joint_trajectory<br/>trajectory_msgs/JointTrajectory"]
        T_TEN["/fishing_arm/tension<br/>interfaces/FishingTension"]
        T_WRENCH["/tension_sensor_broadcaster/wrench<br/>geometry_msgs/WrenchStamped"]
        T_FISH["/fish_effort_controller/commands<br/>std_msgs/Float64MultiArray"]
        T_TF["/tf · /tf_static<br/>tf2_msgs/TFMessage"]
        T_RD["/robot_description<br/>std_msgs/String"]
    end

    RSP --> T_RD
    RSP --> T_TF
    T_TF -.->|"TF lookup<br/>rod_tip_link ↔ fish_link"| LC

    FISH -->|"pub"| T_FISH
    T_FISH -->|"sub"| FEC
    FEC --> MJ
    CTRL -->|"pub"| T_TRAJ
    T_TRAJ -->|"sub"| PTC
    PTC --> MJ
    MJ --> JSB
    JSB -->|"pub"| T_JS
    T_JS -->|"sub"| CTRL
    T_JS -->|"sub"| REC
    MJ --> TSB
    TSB -->|"pub"| T_WRENCH
    T_WRENCH -->|"sub"| LC
    LC -->|"pub"| T_TEN
    T_TEN -->|"sub"| CTRL
    T_TEN -->|"sub"| REC

    MJ -.->|"steps MJCF<br/>fishing-robot_sim.xml"| MJ
